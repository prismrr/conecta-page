# Conecta PrismRR environment template
# Do not commit real secrets to .env files.

# Registration API
REGISTRATION_API_BASE_URL=https://api.example.com
REGISTRATION_API_ENDPOINT_TEMPLATE=/api/registrations/{registrationId}
REGISTRATION_API_TIMEOUT_MS=5000
REGISTRATION_API_MAX_RETRIES=3
REGISTRATION_EXTERNAL_URL=https://example.com/inscricoes

# Telemetry
TELEMETRY_ENABLED=true
TELEMETRY_ENDPOINT_URL=/telemetry/events
TELEMETRY_ENVIRONMENT=development
TELEMETRY_RELEASE_ID=mvp-0.2.0
TELEMETRY_SOURCE_CHANNEL=web
TELEMETRY_CONSOLE_DEBUG=false

# Observability advanced
# Optional external destination for telemetry forwarding.
# Raw example: https://otel-gateway.example.com/events
# Loki example: http://127.0.0.1:3100/loki/api/v1/push
TELEMETRY_FORWARD_URL=
# Provider format used to send telemetry payloads: raw or loki
TELEMETRY_FORWARD_PROVIDER=raw
# Auth mode for forwarding: none, bearer, x-api-key, basic
TELEMETRY_FORWARD_AUTH_TYPE=none
# Token used by bearer or x-api-key modes
TELEMETRY_FORWARD_AUTH_TOKEN=
# Header name used by x-api-key mode
TELEMETRY_FORWARD_AUTH_HEADER=X-API-Key
# Credentials used by basic mode
TELEMETRY_FORWARD_USERNAME=
TELEMETRY_FORWARD_PASSWORD=
# Outbound forwarding timeout
TELEMETRY_FORWARD_TIMEOUT_SECONDS=3
# Basic alerting rule for repeated external sync failures inside the configured time window
OBSERVABILITY_ALERT_FAILURE_THRESHOLD=3
OBSERVABILITY_ALERT_WINDOW_MINUTES=15

# Local observability stack credentials (ops/observability/docker-compose.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
