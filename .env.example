# Conecta PrismRR environment template
# Do not commit real secrets to .env files.

# Registration API
REGISTRATION_API_BASE_URL=https://api.example.com
REGISTRATION_API_ENDPOINT_TEMPLATE=/api/registrations/{registrationId}
REGISTRATION_API_TIMEOUT_MS=5000
REGISTRATION_API_MAX_RETRIES=3
REGISTRATION_EXTERNAL_URL=https://example.com/inscricoes

# Telemetry
TELEMETRY_ENABLED=true
TELEMETRY_ENDPOINT_URL=/telemetry/events
TELEMETRY_ENVIRONMENT=development
TELEMETRY_RELEASE_ID=mvp-0.2.0
TELEMETRY_SOURCE_CHANNEL=web
TELEMETRY_CONSOLE_DEBUG=false

# Observability advanced
# Optional external destination for telemetry forwarding (example: https://otel-gateway.example.com/events)
TELEMETRY_FORWARD_URL=
# Basic alerting rule for repeated external sync failures inside the configured time window
OBSERVABILITY_ALERT_FAILURE_THRESHOLD=3
OBSERVABILITY_ALERT_WINDOW_MINUTES=15
