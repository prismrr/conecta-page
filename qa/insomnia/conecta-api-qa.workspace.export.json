    {
      "_id": "ut_contract_openapi_status_paths",
      "_type": "unit_test",
      "parentId": "uts_contract_assertions",
      "name": "GET /openapi.json -> status 200, header json e openapi 3.x",
      "code": "const response = await insomnia.send('req_utils_openapi');\nexpect(response.status).to.equal(200);\nconst contentType = response.headers['content-type'] || response.headers['Content-Type'] || '';\nexpect(contentType).to.contain('application/json');\nconst body = JSON.parse(response.data);\nexpect(body).to.have.property('openapi');\nexpect(/^3\\./.test(body.openapi)).to.equal(true);\nexpect(body).to.have.property('paths');\nexpect(body.paths).to.have.property('/api/inscricoes/{inscricao_id}');\nexpect(body.paths).to.have.property('/telemetry/events');"
    },
    {
      "_id": "ut_contract_inscricoes_get",
      "_type": "unit_test",
      "parentId": "uts_contract_assertions",
      "name": "GET /api/inscricoes/{id} -> contrato 200 ou 404",
      "code": "const response = await insomnia.send('req_contract_inscricoes_get_by_id');\nconst body = JSON.parse(response.data);\nexpect([200, 404]).to.include(response.status);\nif (response.status === 200) {\n  expect(body).to.have.property('id');\n  expect(body).to.have.property('status');\n  expect(body).to.have.property('ultimaAtualizacao');\n} else {\n  expect(body).to.have.property('ok', false);\n  expect(body).to.have.property('error', 'not_found');\n}"
    },
