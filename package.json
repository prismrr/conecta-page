{
  "name": "conecta-page",
  "version": "0.1.0",
  "private": true,
  "description": "Conecta PrismRR static site with contract-safe integration and telemetry.",
  "scripts": {
    "test": "npm run test:unit && npm run test:contract && npm run test:integration && npm run test:a11y && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:smoke": "bash scripts/smoke_test.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.54.0",
    "vitest": "^2.0.5"
  }
}
