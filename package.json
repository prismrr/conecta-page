{
  "name": "conecta-page",
  "version": "0.1.0",
  "private": true,
  "description": "Conecta PrismRR static site with contract-safe integration and telemetry.",
  "scripts": {
    "nuxt:dev": "nuxt dev nuxt-app",
    "nuxt:build": "nuxt build nuxt-app",
    "nuxt:generate": "nuxt generate nuxt-app",
    "nuxt:preview": "nuxt preview nuxt-app",
    "api:dev": "python3 backend/fastapi_server.py",
    "ingestion:worker": "celery -A backend.ingestion.celery_app.celery_app worker --loglevel=INFO -Q ingestao_csv",
    "ingestion:beat": "celery -A backend.ingestion.celery_app.celery_app beat --loglevel=INFO",
    "ingestion:run": "python3 -c \"from backend.ingestion.tasks import sync_inscricoes_from_csv; print(sync_inscricoes_from_csv())\"",
    "test": "npm run test:unit && npm run test:component && npm run test:contract && npm run test:integration && npm run test:a11y && npm run test:vrt && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:contract": "vitest run tests/contract",
    "test:contract:provider": "vitest run tests/contract/registration-provider-prism.contract.test.js",
    "test:integration": "vitest run tests/integration",
    "test:api:functional:karate": "cd tests/api/karate && mvn -q test",
    "test:api:functional:karate:smoke": "cd tests/api/karate && mvn -q test -Dkarate.tags=@smoke",
    "test:api:functional:karate:regression": "cd tests/api/karate && mvn -q test -Dkarate.tags=@regression",
    "test:api:functional:karate:compliance": "cd tests/api/karate && mvn -q test -Dkarate.tags=@compliance",
    "test:api:functional:karate:local": "bash scripts/run_karate_local.sh",
    "test:api:functional:karate:local:smoke": "KARATE_TAGS=@smoke bash scripts/run_karate_local.sh",
    "test:api:functional:karate:local:regression": "KARATE_TAGS=@regression bash scripts/run_karate_local.sh",
    "test:api:functional:karate:local:compliance": "KARATE_TAGS=@compliance bash scripts/run_karate_local.sh",
    "test:api:performance:k6": "k6 run tests/performance/k6/api-load.js",
    "test:api:performance:k6:local": "bash scripts/run_k6_local.sh",
    "test:api:performance:k6:local:smoke": "K6_PROFILE=smoke bash scripts/run_k6_local.sh",
    "test:api:performance:k6:local:stress": "K6_PROFILE=stress bash scripts/run_k6_local.sh",
    "test:api:performance:k6:grafana": "K6_PROFILE=baseline BASE_URL=http://127.0.0.1:8080 K6_PROMETHEUS_RW_SERVER_URL=http://127.0.0.1:9090/api/v1/write k6 run -o experimental-prometheus-rw tests/performance/k6/api-load.js",
    "test:api:security:zap": "bash scripts/zap_api_scan.sh",
    "test:api:security:zap:local": "bash scripts/run_zap_local.sh",
    "compliance:privacy:inventory": "node scripts/privacy_inventory_check.js",
    "test:a11y": "playwright test -c playwright.nuxt.config.js tests/e2e/nuxt/accessibility.nuxt.spec.js",
    "test:vrt": "playwright test -c playwright.nuxt.config.js tests/e2e/nuxt/visual-regression.nuxt.spec.js",
    "test:e2e": "playwright test -c playwright.nuxt.config.js",
    "test:e2e:nuxt": "playwright test -c playwright.nuxt.config.js",
    "test:e2e:nuxt:inscricoes": "playwright test -c playwright.nuxt.config.js tests/e2e/nuxt/inscricoes.nuxt.spec.js",
    "test:e2e:nuxt:programacao": "playwright test -c playwright.nuxt.config.js tests/e2e/nuxt/programacao.nuxt.spec.js",
    "test:e2e:nuxt:faq": "playwright test -c playwright.nuxt.config.js tests/e2e/nuxt/faq.nuxt.spec.js",
    "test:e2e:nuxt:legal-versioning": "playwright test -c playwright.nuxt.config.js tests/e2e/nuxt/legal-versioning.nuxt.spec.js",
    "test:e2e:nuxt:dsar": "playwright test -c playwright.nuxt.config.js tests/e2e/nuxt/dsar-channel.nuxt.spec.js",
    "test:e2e:nuxt:consent": "playwright test -c playwright.nuxt.config.js tests/e2e/nuxt/consent-flow.nuxt.spec.js",
    "test:e2e:nuxt:audit": "playwright test -c playwright.nuxt.config.js tests/e2e/nuxt/audit-trail.nuxt.spec.js",
    "test:e2e:headed": "playwright test --headed",
    "test:smoke": "bash scripts/smoke_test.sh",
    "compliance:third-party:inventory": "node scripts/third_party_inventory_check.js",
    "compliance:backup:restore": "python3 backend/jobs/backup_restore_drill.py --db-file data/compliance.db --report-file logs/compliance-backup-restore-report.json --summary-file logs/compliance-backup-restore-summary.md --backup-file logs/compliance-backups/compliance-backup.sqlite --restored-file logs/compliance-backups/compliance-restored.sqlite",
    "ci:tests": "npm run compliance:privacy:inventory && npm run compliance:third-party:inventory && npm run test:unit && npm run test:component && npm run test:contract && npm run test:contract:provider && npm run test:integration && npm run test:a11y && npm run test:vrt && npm run test:e2e && npm run test:smoke && npm run compliance:backup:restore && npm run compliance:incident:drill && npm run ci:artifacts:test",
    "ci:build": "npm run deploy:build && npm run ci:artifacts:build",
    "ci:artifacts:test": "test -f logs/compliance-incident-drill-report.json && test -f logs/compliance-incident-drill-summary.md && test -f data/compliance.db",
    "ci:artifacts:build": "test -f .deploy/dist/index.html && test -f .deploy/dist/RELEASE_MANIFEST.json",
    "build:ci": "npm run ci:tests && npm run ci:build",
    "dev:docker:build": "bash scripts/dev_docker.sh build",
    "dev:docker": "bash scripts/dev_docker.sh up",
    "dev:docker:down": "bash scripts/dev_docker.sh down",
    "dev:docker:logs": "bash scripts/dev_docker.sh logs",
    "dev:docker:ingestion:up": "bash scripts/dev_docker.sh ingestion-up",
    "dev:docker:ingestion:trigger": "bash scripts/dev_docker.sh ingestion-trigger",
    "dev:docker:ingestion:logs": "bash scripts/dev_docker.sh ingestion-logs",
    "dev:docker:ingestion:down": "bash scripts/dev_docker.sh ingestion-down",
    "dev:docker:full": "npm run dev:docker:build && PWD=$(pwd) TELEMETRY_FORWARD_URL=http://loki:3100/loki/api/v1/push TELEMETRY_FORWARD_PROVIDER=loki docker compose -f docker-compose.local.yml -f infra/observability/docker-compose.yml up -d",
    "dev:docker:full:down": "PWD=$(pwd) docker compose -f docker-compose.local.yml -f infra/observability/docker-compose.yml down",
    "dev:docker:full:logs": "PWD=$(pwd) docker compose -f docker-compose.local.yml -f infra/observability/docker-compose.yml logs -f",
    "deploy:build": "bash backend/deploy/build_static.sh .deploy/dist",
    "deploy:develop": "bash backend/deploy/deploy_develop.sh .deploy/dist",
    "deploy:production": "bash backend/deploy/deploy_production.sh .deploy/dist",
    "compliance:retention": "python3 backend/jobs/retention_job.py --db-file data/compliance.db --report-file logs/compliance-retention-report.json",
    "compliance:retention:dry-run": "python3 backend/jobs/retention_job.py --db-file data/compliance.db --report-file logs/compliance-retention-report.json --dry-run",
    "compliance:incident:drill": "python3 backend/jobs/incident_drill.py --db-file data/compliance.db --report-file logs/compliance-incident-drill-report.json",
    "compliance:incident:drill:observe": "python3 backend/jobs/incident_drill.py --db-file data/compliance.db --report-file logs/compliance-incident-drill-report.json --no-simulate"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "@pinia/nuxt": "^0.5.5",
    "@axe-core/playwright": "^4.11.3",
    "jsdom": "^24.1.3",
    "nuxt": "^3.17.5",
    "pinia": "^2.3.1",
    "@playwright/test": "^1.54.0",
    "vitest": "^2.0.5"
  }
}
