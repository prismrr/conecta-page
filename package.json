{
  "name": "conecta-page",
  "version": "0.1.0",
  "private": true,
  "description": "Conecta PrismRR static site with contract-safe integration and telemetry.",
  "scripts": {
    "test": "npm run test:unit && npm run test:component && npm run test:contract && npm run test:integration && npm run test:a11y && npm run test:vrt && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:contract": "vitest run tests/contract",
    "test:contract:provider": "vitest run tests/contract/registration-provider-prism.contract.test.js",
    "test:integration": "vitest run tests/integration",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.js",
    "test:vrt": "playwright test tests/e2e/visual-regression.spec.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:smoke": "bash scripts/smoke_test.sh",
    "dev:docker": "bash scripts/dev_docker.sh up",
    "dev:docker:down": "bash scripts/dev_docker.sh down",
    "dev:docker:logs": "bash scripts/dev_docker.sh logs",
    "dev:docker:full": "PWD=$(pwd) TELEMETRY_FORWARD_URL=http://loki:3100/loki/api/v1/push TELEMETRY_FORWARD_PROVIDER=loki docker compose -f docker-compose.local.yml -f ops/observability/docker-compose.yml up -d",
    "dev:docker:full:down": "PWD=$(pwd) docker compose -f docker-compose.local.yml -f ops/observability/docker-compose.yml down",
    "dev:docker:full:logs": "PWD=$(pwd) docker compose -f docker-compose.local.yml -f ops/observability/docker-compose.yml logs -f",
    "deploy:build": "bash scripts/deploy/build_static.sh .deploy/dist",
    "deploy:develop": "bash scripts/deploy/deploy_develop.sh .deploy/dist",
    "deploy:production": "bash scripts/deploy/deploy_production.sh .deploy/dist",
    "compliance:retention": "python3 scripts/retention_job.py --db-file data/compliance.db --report-file logs/compliance-retention-report.json",
    "compliance:retention:dry-run": "python3 scripts/retention_job.py --db-file data/compliance.db --report-file logs/compliance-retention-report.json --dry-run",
    "compliance:incident:drill": "python3 scripts/incident_drill.py --db-file data/compliance.db --report-file logs/compliance-incident-drill-report.json",
    "compliance:incident:drill:observe": "python3 scripts/incident_drill.py --db-file data/compliance.db --report-file logs/compliance-incident-drill-report.json --no-simulate"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.54.0",
    "vitest": "^2.0.5"
  }
}
